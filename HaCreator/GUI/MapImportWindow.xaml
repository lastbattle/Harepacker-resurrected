<Window x:Class="HaCreator.GUI.MapImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dialogLoc="clr-namespace:HaCreator.GUI.Localization"
        Title="{dialogLoc:DialogText MapImport_Title}"
        Width="1060" Height="720" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource HareCanvasBrush}" FontFamily="Segoe UI">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/HaSharedLibrary;component/GUI/Themes/HarepackerTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="ImportButton" TargetType="Button">
                <Setter Property="Height" Value="34"/>
                <Setter Property="MinWidth" Value="92"/>
                <Setter Property="Padding" Value="14,0"/>
                <Setter Property="Background" Value="White"/>
                <Setter Property="BorderBrush" Value="#DCE3EC"/>
                <Setter Property="BorderThickness" Value="1"/>
            </Style>
            <Style x:Key="ImportPrimaryButton" TargetType="Button" BasedOn="{StaticResource ImportButton}">
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Background" Value="#2563EB"/>
                <Setter Property="BorderBrush" Value="#2563EB"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="White"/>
                <Setter Property="BorderBrush" Value="#DCE3EC"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="20,16" Background="White" BorderBrush="#DCE3EC" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="42"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="34" Height="34" Background="#EFF6FF" CornerRadius="8">
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#2563EB" Text="&#xE8B5;"/>
                </Border>
                <StackPanel Grid.Column="1">
                    <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="#0F172A"
                               Text="{dialogLoc:DialogText MapImport_Title}"/>
                    <TextBlock Margin="0,3,0,0" Foreground="#64748B" TextWrapping="Wrap"
                               Text="{dialogLoc:DialogText MapImport_Description}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Margin="16,14,16,0" Padding="14" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Text="{dialogLoc:DialogText MapImport_SourceExport}"/>
                <TextBox x:Name="sourcePathTextBox" Grid.Row="1" Height="34" Margin="0,5,10,0" Padding="9,4"
                         VerticalContentAlignment="Center" TextChanged="SourcePathTextBox_TextChanged"/>
                <Button x:Name="browseButton" Grid.Row="1" Grid.Column="1" Margin="0,5,0,0"
                        Style="{StaticResource ImportButton}" Click="BrowseButton_Click" Content="{dialogLoc:DialogText MapImport_Browse}"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="360"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="3*" MinWidth="360"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Margin="14,12,14,0">
                        <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="#0F172A" Text="{dialogLoc:DialogText MapImport_ChooseMaps}"/>
                        <TextBlock Margin="0,3,0,0" Foreground="#64748B" Text="{dialogLoc:DialogText MapImport_MultiSelectHelp}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Margin="14,10,14,8">
                        <TextBox x:Name="mapFilterTextBox" Height="32" Padding="9,3"
                                 VerticalContentAlignment="Center" TextChanged="MapFilterTextBox_TextChanged"
                                 ToolTip="{dialogLoc:DialogText MapImport_FilterTooltip}"/>
                        <CheckBox x:Name="onlyMissingMapsCheckBox" Margin="0,7,0,0"
                                  Checked="OnlyMissingMapsCheckBox_Changed" Unchecked="OnlyMissingMapsCheckBox_Changed"
                                  Content="{dialogLoc:DialogText MapImport_OnlyMissingMaps}"/>
                    </StackPanel>
                    <ListView x:Name="mapsListView" Grid.Row="2" Margin="8,0" BorderThickness="0"
                              SelectionMode="Extended" SelectionChanged="MapsListView_SelectionChanged">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="{dialogLoc:DialogText MapImport_Street}" Width="150" DisplayMemberBinding="{Binding StreetName}"/>
                                <GridViewColumn Header="{dialogLoc:DialogText MapImport_MapName}" Width="170" DisplayMemberBinding="{Binding MapName}"/>
                                <GridViewColumn Header="{dialogLoc:DialogText MapImport_MapId}" Width="92" DisplayMemberBinding="{Binding MapId}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                    <Grid Grid.Row="3" Margin="14,8,14,12">
                        <TextBlock x:Name="mapCountTextBlock" VerticalAlignment="Center" Foreground="#64748B"/>
                        <Button x:Name="reviewButton" HorizontalAlignment="Right" Style="{StaticResource ImportPrimaryButton}"
                                Click="ReviewButton_Click" Content="{dialogLoc:DialogText MapImport_ReviewAdditions}" IsEnabled="False"/>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Margin="14,12,14,0">
                        <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="#0F172A" Text="{dialogLoc:DialogText MapImport_ConfirmPlan}"/>
                        <TextBlock x:Name="planSummaryTextBlock" Margin="0,3,0,0" Foreground="#64748B" TextWrapping="Wrap"
                                   Text="{dialogLoc:DialogText MapImport_InitialPlan}"/>
                    </StackPanel>
                    <Border Grid.Row="1" Margin="14,10,14,8" Padding="10,7" Background="#F8FAFC" CornerRadius="6">
                        <StackPanel>
                            <TextBlock x:Name="destinationTextBlock" Foreground="#475569" TextWrapping="Wrap"/>
                            <CheckBox x:Name="replaceMapsCheckBox" Margin="0,7,0,0"
                                      Checked="ReplaceMapsCheckBox_Changed" Unchecked="ReplaceMapsCheckBox_Changed"
                                      Content="{dialogLoc:DialogText MapImport_ReplaceMaps}"/>
                        </StackPanel>
                    </Border>
                    <DataGrid x:Name="planDataGrid" Grid.Row="2" Margin="8,0" AutoGenerateColumns="False"
                              IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal" BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{dialogLoc:DialogText MapImport_Type}" Width="90" Binding="{Binding KindDisplay}"/>
                            <DataGridTextColumn Header="{dialogLoc:DialogText MapImport_AssetEntry}" Width="*" Binding="{Binding DisplayPath}"/>
                            <DataGridTextColumn Header="{dialogLoc:DialogText MapImport_Action}" Width="92" Binding="{Binding StatusDisplay}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border Grid.Row="3" Margin="14,8,14,12" Padding="10" Background="#FFF7ED" CornerRadius="6">
                        <TextBlock Foreground="#9A3412" TextWrapping="Wrap"
                                   Text="{dialogLoc:DialogText MapImport_PreservationWarning}"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="3" Padding="16,12" Background="White" BorderBrush="#DCE3EC" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="statusTextBlock" Foreground="#475569" Text="{dialogLoc:DialogText MapImport_InitialStatus}"/>
                    <ProgressBar x:Name="progressBar" Height="3" Margin="0,5,18,0" Visibility="Collapsed" IsIndeterminate="True"/>
                </StackPanel>
                <Button Grid.Column="1" Margin="0,0,8,0" Style="{StaticResource ImportButton}" Click="CancelButton_Click" Content="{dialogLoc:DialogText MapImport_Cancel}"/>
                <Button x:Name="importButton" Grid.Column="2" Style="{StaticResource ImportPrimaryButton}"
                        Click="ImportButton_Click" Content="{dialogLoc:DialogText MapImport_ImportSelected}" IsEnabled="False"/>
            </Grid>
        </Border>
    </Grid>
</Window>
