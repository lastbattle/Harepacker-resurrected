<Window x:Class="HaCreator.GUI.WorldMap.WorldMapWorkspace"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:world="clr-namespace:HaCreator.GUI.WorldMap"
        Title="{world:WorldMapEditorText Title}"
        Width="1600" Height="980" MinWidth="1280" MinHeight="720"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        SizeChanged="Workspace_SizeChanged"
        PreviewKeyDown="Workspace_PreviewKeyDown">
    <Window.CommandBindings>
        <CommandBinding Command="{x:Static world:WorldMapWorkspace.NewSurfaceCommand}" CanExecute="AlwaysCanExecute" Executed="NewSurface_Executed"/>
        <CommandBinding Command="{x:Static world:WorldMapWorkspace.DuplicateSurfaceCommand}" CanExecute="AlwaysCanExecute" Executed="DuplicateSurface_Executed"/>
        <CommandBinding Command="{x:Static world:WorldMapWorkspace.OpenReloadCommand}" CanExecute="AlwaysCanExecute" Executed="OpenReload_Executed"/>
        <CommandBinding Command="{x:Static world:WorldMapWorkspace.SaveSelectedCommand}" CanExecute="AlwaysCanExecute" Executed="SaveSelected_Executed"/>
        <CommandBinding Command="{x:Static world:WorldMapWorkspace.SaveAllCommand}" CanExecute="AlwaysCanExecute" Executed="SaveAll_Executed"/>
        <CommandBinding Command="{x:Static world:WorldMapWorkspace.AddMarkerCommand}" CanExecute="AlwaysCanExecute" Executed="AddMarker_Executed"/>
        <CommandBinding Command="{x:Static world:WorldMapWorkspace.AddLinkCommand}" CanExecute="AlwaysCanExecute" Executed="AddLink_Executed"/>
        <CommandBinding Command="{x:Static world:WorldMapWorkspace.AddFogCommand}" CanExecute="AlwaysCanExecute" Executed="AddFog_Executed"/>
        <CommandBinding Command="{x:Static world:WorldMapWorkspace.RemoveMarkerCommand}" CanExecute="AlwaysCanExecute" Executed="RemoveMarker_Executed"/>
        <CommandBinding Command="{x:Static world:WorldMapWorkspace.RemoveLinkCommand}" CanExecute="AlwaysCanExecute" Executed="RemoveLink_Executed"/>
        <CommandBinding Command="{x:Static world:WorldMapWorkspace.RemoveFogCommand}" CanExecute="AlwaysCanExecute" Executed="RemoveFog_Executed"/>
        <CommandBinding Command="{x:Static world:WorldMapWorkspace.AddMapToMarkerCommand}" CanExecute="AlwaysCanExecute" Executed="AddMapToMarker_Executed"/>
        <CommandBinding Command="{x:Static world:WorldMapWorkspace.CreateChildCommand}" CanExecute="AlwaysCanExecute" Executed="CreateChild_Executed"/>
        <CommandBinding Command="{x:Static world:WorldMapWorkspace.RemoveFromHierarchyCommand}" CanExecute="AlwaysCanExecute" Executed="RemoveFromHierarchy_Executed"/>
        <CommandBinding Command="{x:Static world:WorldMapWorkspace.DeleteAssetCommand}" CanExecute="AlwaysCanExecute" Executed="DeleteAsset_Executed"/>
        <CommandBinding Command="{x:Static world:WorldMapWorkspace.ValidateSelectedCommand}" CanExecute="AlwaysCanExecute" Executed="ValidateSelected_Executed"/>
        <CommandBinding Command="{x:Static world:WorldMapWorkspace.ValidateAllCommand}" CanExecute="AlwaysCanExecute" Executed="ValidateAll_Executed"/>
        <CommandBinding Command="{x:Static world:WorldMapWorkspace.ReplaceBackgroundCommand}" CanExecute="AlwaysCanExecute" Executed="ReplaceBackground_Executed"/>
        <CommandBinding Command="{x:Static world:WorldMapWorkspace.ReviewChangesCommand}" CanExecute="AlwaysCanExecute" Executed="ReviewChanges_Executed"/>
        <CommandBinding Command="{x:Static world:WorldMapWorkspace.FitCanvasCommand}" CanExecute="AlwaysCanExecute" Executed="FitCanvas_Executed"/>
        <CommandBinding Command="{x:Static world:WorldMapWorkspace.ZoomOutCommand}" CanExecute="AlwaysCanExecute" Executed="ZoomOut_Executed"/>
        <CommandBinding Command="{x:Static world:WorldMapWorkspace.ZoomInCommand}" CanExecute="AlwaysCanExecute" Executed="ZoomIn_Executed"/>
        <CommandBinding Command="{x:Static world:WorldMapWorkspace.RuntimePreviewCommand}" CanExecute="AlwaysCanExecute" Executed="RuntimePreview_Executed"/>
        <CommandBinding Command="ApplicationCommands.Undo" CanExecute="AlwaysCanExecute" Executed="Undo_Executed"/>
        <CommandBinding Command="ApplicationCommands.Redo" CanExecute="AlwaysCanExecute" Executed="Redo_Executed"/>
    </Window.CommandBindings>
    <Window.InputBindings>
        <KeyBinding Command="{x:Static world:WorldMapWorkspace.NewSurfaceCommand}" Gesture="Ctrl+N"/>
        <KeyBinding Command="{x:Static world:WorldMapWorkspace.OpenReloadCommand}" Gesture="Ctrl+O"/>
        <KeyBinding Command="{x:Static world:WorldMapWorkspace.SaveAllCommand}" Gesture="Ctrl+S"/>
        <KeyBinding Command="ApplicationCommands.Undo" Gesture="Ctrl+Z"/>
        <KeyBinding Command="ApplicationCommands.Redo" Gesture="Ctrl+Y"/>
        <KeyBinding Command="{x:Static world:WorldMapWorkspace.AddMarkerCommand}" Gesture="Ctrl+M"/>
        <KeyBinding Command="{x:Static world:WorldMapWorkspace.FitCanvasCommand}" Gesture="Ctrl+F"/>
    </Window.InputBindings>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/HaSharedLibrary;component/GUI/Themes/HarepackerTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
            <world:WorldMapMapReferenceConverter x:Key="MapReferenceConverter"/>
            <Style x:Key="InspectorLabel" TargetType="TextBlock" BasedOn="{StaticResource HareMutedTextStyle}">
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="0,2,8,4"/>
            </Style>
            <Style x:Key="CompactInspectorLabel" TargetType="TextBlock" BasedOn="{StaticResource InspectorLabel}">
                <Setter Property="Width" Value="58"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>
            <Style x:Key="InspectorTextBox" TargetType="TextBox">
                <Setter Property="Margin" Value="0,2,0,4"/>
                <Setter Property="MinWidth" Value="90"/>
            </Style>
            <Style x:Key="InspectorComboBox" TargetType="ComboBox">
                <Setter Property="Margin" Value="0,2,0,4"/>
                <Setter Property="MinWidth" Value="90"/>
            </Style>
            <Style x:Key="MarkerButton" TargetType="Button" BasedOn="{StaticResource HareIconButtonStyle}">
                <Setter Property="Width" Value="36"/>
                <Setter Property="Height" Value="26"/>
                <Setter Property="Padding" Value="2"/>
                <Setter Property="ToolTip" Value="{Binding DisplayName}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Chrome" CornerRadius="4" Background="{StaticResource HareSurfaceBrush}" BorderBrush="{StaticResource HareBorderBrush}" BorderThickness="1">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{StaticResource HareAccentSoftBrush}"/></Trigger>
                                <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{StaticResource HareAccentSoftBrush}"/></Trigger>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter TargetName="Chrome" Property="Background" Value="{StaticResource HareAccentSoftBrush}"/>
                                    <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource HareAccentBrush}"/>
                                    <Setter TargetName="Chrome" Property="BorderThickness" Value="2"/>
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="CanvasToolToggleStyle" TargetType="ToggleButton">
                <Setter Property="Width" Value="38"/>
                <Setter Property="Height" Value="38"/>
                <Setter Property="Foreground" Value="{StaticResource HareTextBrush}"/>
                <Setter Property="Background" Value="{StaticResource HareSurfaceBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource HareBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{StaticResource HareAccentSoftBrush}"/></Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Chrome" Property="Background" Value="{StaticResource HareAccentSoftBrush}"/>
                                    <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource HareAccentBrush}"/>
                                    <Setter Property="Foreground" Value="{StaticResource HareAccentBrush}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                                <DataTrigger Binding="{Binding SelectedSurface}" Value="{x:Null}"><Setter Property="IsEnabled" Value="False"/></DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="CanvasDeleteToolStyle" TargetType="Button" BasedOn="{StaticResource HareIconButtonStyle}">
                <Setter Property="Width" Value="38"/>
                <Setter Property="Height" Value="38"/>
                <Setter Property="Margin" Value="0,4,0,0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding SelectedMarker}" Value="{x:Null}"><Setter Property="IsEnabled" Value="False"/></DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="CanvasItemContainerStyle" TargetType="ContentPresenter">
                <Setter Property="Canvas.Left" Value="{Binding CanvasX}"/>
                <Setter Property="Canvas.Top" Value="{Binding CanvasY}"/>
            </Style>
            <ItemsPanelTemplate x:Key="CanvasItemsPanelTemplate"><Canvas/></ItemsPanelTemplate>
            <DataTemplate x:Key="CanvasMarkerTemplate">
                <Border Background="Transparent" Cursor="SizeAll" Focusable="True" ToolTip="{world:WorldMapEditorText CanvasInteractionHint}" PreviewMouseLeftButtonDown="Marker_PreviewMouseLeftButtonDown" MouseMove="Marker_MouseMove" PreviewMouseLeftButtonUp="Marker_PreviewMouseLeftButtonUp">
                    <StackPanel Orientation="Vertical">
                        <Image Source="{Binding MarkerImage}" Width="28" Height="28" Stretch="Uniform" HorizontalAlignment="Center" IsHitTestVisible="False"/>
                        <Button Style="{StaticResource MarkerButton}" Content="{Binding MarkerType}" Click="Marker_Click" Focusable="False"/>
                        <TextBlock Text="{Binding DisplayName}" FontSize="10" HorizontalAlignment="Center" MaxWidth="120" TextTrimming="CharacterEllipsis" IsHitTestVisible="False" Visibility="{Binding DataContext.ShowLabels, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}"/>
                    </StackPanel>
                </Border>
            </DataTemplate>
            <DrawingBrush x:Key="CanvasGridBrush" TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute" Stretch="None">
                <DrawingBrush.Drawing>
                    <DrawingGroup>
                        <GeometryDrawing Brush="{StaticResource HareSurfaceBrush}" Geometry="M0,0 L16,0 16,16 0,16Z"/>
                        <GeometryDrawing Brush="#E6EAF0" Geometry="M0,0 L16,0 16,1 0,1Z M0,0 L1,0 1,16 0,16Z"/>
                    </DrawingGroup>
                </DrawingBrush.Drawing>
            </DrawingBrush>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{StaticResource HareCanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="380"/>
            <RowDefinition Height="170" MinHeight="120"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Compact command bar: Save all is the single primary action. -->
        <Border Grid.Row="0" Style="{StaticResource HareToolbarStyle}" Margin="12,12,12,8">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Margin="0,0,14,0" Content="{world:WorldMapEditorText AISettings}" Click="AISettings_Click"
                            ToolTip="{world:WorldMapEditorText AISettingsHint}" AutomationProperties.Name="{world:WorldMapEditorText AISettings}"/>
                    <TextBlock Text="{world:WorldMapEditorText Source}" Style="{StaticResource HareMutedTextStyle}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding SourceName}" Margin="6,0,14,0" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="180" ToolTip="{Binding SourceName}"/>
                    <TextBlock Text="{Binding SourceMode}" Style="{StaticResource HareMutedTextStyle}" VerticalAlignment="Center"/>
                    <Border Margin="12,0,0,0" Padding="8,3" Background="{StaticResource HareSurfaceAltBrush}" CornerRadius="4">
                        <TextBlock Text="{Binding DirtySummary}" Style="{StaticResource HareMutedTextStyle}"/>
                    </Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource HareButtonStyle}" Content="{world:WorldMapEditorText NewSurface}" Command="{x:Static world:WorldMapWorkspace.NewSurfaceCommand}" AutomationProperties.Name="{world:WorldMapEditorText NewSurface}"/>
                    <Button Margin="6,0,0,0" Content="{world:WorldMapEditorText DuplicateSurface}" Command="{x:Static world:WorldMapWorkspace.DuplicateSurfaceCommand}" AutomationProperties.Name="{world:WorldMapEditorText DuplicateSurface}"/>
                    <Button Margin="6,0,0,0" Content="{world:WorldMapEditorText OpenReload}" Command="{x:Static world:WorldMapWorkspace.OpenReloadCommand}" AutomationProperties.Name="{world:WorldMapEditorText OpenReload}"/>
                    <Button Margin="6,0,0,0" Content="{world:WorldMapEditorText SaveSelected}" Command="{x:Static world:WorldMapWorkspace.SaveSelectedCommand}" AutomationProperties.Name="{world:WorldMapEditorText SaveSelected}"/>
                    <Button Margin="6,0,0,0" Style="{StaticResource HarePrimaryButtonStyle}" Content="{world:WorldMapEditorText SaveAll}" Command="{x:Static world:WorldMapWorkspace.SaveAllCommand}" AutomationProperties.Name="{world:WorldMapEditorText SaveAll}"/>
                    <Separator Width="8" Style="{StaticResource {x:Type Separator}}"/>
                    <Button Style="{StaticResource HareIconButtonStyle}" Content="↶" ToolTip="{world:WorldMapEditorText Undo}" AutomationProperties.Name="{world:WorldMapEditorText Undo}" Command="ApplicationCommands.Undo"/>
                    <Button Style="{StaticResource HareIconButtonStyle}" Content="↷" ToolTip="{world:WorldMapEditorText Redo}" AutomationProperties.Name="{world:WorldMapEditorText Redo}" Command="ApplicationCommands.Redo"/>
                    <Separator Width="8" Style="{StaticResource {x:Type Separator}}"/>
                    <Button Content="{world:WorldMapEditorText ValidateSelected}" Command="{x:Static world:WorldMapWorkspace.ValidateSelectedCommand}" AutomationProperties.Name="{world:WorldMapEditorText ValidateSelected}"/>
                    <Button Margin="6,0,0,0" Content="{world:WorldMapEditorText ValidateAll}" Command="{x:Static world:WorldMapWorkspace.ValidateAllCommand}" AutomationProperties.Name="{world:WorldMapEditorText ValidateAll}" ToolTip="{world:WorldMapEditorText ValidateAllHint}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <TextBlock Grid.Row="1" Margin="16,0,16,8" Text="{world:WorldMapEditorText Purpose}" Style="{StaticResource HareMutedTextStyle}" TextTrimming="CharacterEllipsis"/>

        <!-- The authoring shell: navigator, native WPF canvas, inspector. -->
        <Grid Grid.Row="2" Margin="12,0,12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="292" MinWidth="240"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*" MinWidth="480"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="350" MinWidth="290"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource HareCardStyle}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="{world:WorldMapEditorText Surfaces}" Style="{StaticResource HareSectionTitleStyle}"/>
                    <TextBox Grid.Row="1" Margin="0,8,0,10" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="{world:WorldMapEditorText Search}" AutomationProperties.Name="{world:WorldMapEditorText Search}"/>
                    <TabControl Grid.Row="2">
                        <TabItem Header="{world:WorldMapEditorText Hierarchy}">
                            <ListBox x:Name="surfaceList" ItemsSource="{Binding FilteredSurfaces}" SelectedItem="{Binding SelectedSurface, Mode=TwoWay}" SelectionChanged="Surface_SelectionChanged" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" AutomationProperties.Name="{world:WorldMapEditorText Hierarchy}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="8,7" Margin="0,1" CornerRadius="4">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding LogicalName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding ImagePath}" Style="{StaticResource HareMutedTextStyle}" FontSize="10" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding ParentName}" Style="{StaticResource HareMutedTextStyle}" FontSize="10" TextTrimming="CharacterEllipsis" Visibility="{Binding ParentName, Converter={StaticResource BoolToVisibility}}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                                    <TextBlock Text="{Binding MarkerCount}" Foreground="{StaticResource HareAccentBrush}" HorizontalAlignment="Right"/>
                                                    <TextBlock Text="{Binding DiagnosticsCount}" Foreground="{StaticResource HareWarningBrush}" HorizontalAlignment="Right"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </TabItem>
                        <TabItem Header="{world:WorldMapEditorText FlatAssets}">
                            <ListBox ItemsSource="{Binding FilteredSurfaces}" SelectedItem="{Binding SelectedSurface, Mode=TwoWay}" BorderThickness="0" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" DisplayMemberPath="ImagePath"/>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

            <Border Grid.Column="2" Style="{StaticResource HareCardStyle}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource HareIconButtonStyle}" Content="−" ToolTip="{world:WorldMapEditorText ZoomOut}" AutomationProperties.Name="{world:WorldMapEditorText ZoomOut}" Command="{x:Static world:WorldMapWorkspace.ZoomOutCommand}"/>
                            <TextBlock Text="{Binding Zoom, StringFormat={}{0:P0}}" Width="52" TextAlignment="Center" VerticalAlignment="Center"/>
                            <Button Style="{StaticResource HareIconButtonStyle}" Content="＋" ToolTip="{world:WorldMapEditorText ZoomIn}" AutomationProperties.Name="{world:WorldMapEditorText ZoomIn}" Command="{x:Static world:WorldMapWorkspace.ZoomInCommand}"/>
                            <Button Margin="6,0,0,0" Content="{world:WorldMapEditorText FitCanvas}" Command="{x:Static world:WorldMapWorkspace.FitCanvasCommand}"/>
                        </StackPanel>
                        <TextBlock Text="{world:WorldMapEditorText Canvas}" Style="{StaticResource HareSectionTitleStyle}" VerticalAlignment="Center"/>
                    </DockPanel>
                    <Border Grid.Row="1" Background="{StaticResource HareSurfaceAltBrush}" BorderBrush="{StaticResource HareBorderBrush}" BorderThickness="1" CornerRadius="7" ClipToBounds="True">
                        <ScrollViewer x:Name="canvasScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Focusable="False">
                            <Grid>
                                <Canvas x:Name="worldCanvas" Width="{Binding SelectedSurface.BaseWidth, TargetNullValue=640}" Height="{Binding SelectedSurface.BaseHeight, TargetNullValue=470}" Focusable="True" MouseLeftButtonDown="Canvas_MouseLeftButtonDown" MouseRightButtonDown="Canvas_MouseRightButtonDown" PreviewMouseWheel="Canvas_PreviewMouseWheel">
                                    <Canvas.Style>
                                        <Style TargetType="Canvas">
                                            <Setter Property="Background" Value="{StaticResource CanvasGridBrush}"/>
                                            <Style.Triggers><DataTrigger Binding="{Binding ShowGrid}" Value="False"><Setter Property="Background" Value="{StaticResource HareSurfaceBrush}"/></DataTrigger></Style.Triggers>
                                        </Style>
                                    </Canvas.Style>
                                    <Canvas.LayoutTransform><ScaleTransform ScaleX="{Binding Zoom}" ScaleY="{Binding Zoom}"/></Canvas.LayoutTransform>
                                    <Image x:Name="baseImage" Width="{Binding SelectedSurface.BaseWidth, TargetNullValue=640}" Height="{Binding SelectedSurface.BaseHeight, TargetNullValue=470}" Stretch="Fill" IsHitTestVisible="False"/>
                                    <Rectangle Width="{Binding SelectedSurface.BaseWidth, TargetNullValue=640}" Height="{Binding SelectedSurface.BaseHeight, TargetNullValue=470}" Stroke="{StaticResource HareBorderBrush}" StrokeThickness="1" Fill="Transparent" IsHitTestVisible="False" Visibility="{Binding ShowRawBounds, Converter={StaticResource BoolToVisibility}}"/>
                                    <ItemsControl x:Name="canvasItemsControl" ItemsSource="{Binding SelectedSurface.Markers}" ItemContainerStyle="{StaticResource CanvasItemContainerStyle}" ItemsPanel="{StaticResource CanvasItemsPanelTemplate}" ItemTemplate="{StaticResource CanvasMarkerTemplate}"/>
                                </Canvas>
                                <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10" Padding="4" Panel.ZIndex="10" Background="{StaticResource HareSurfaceBrush}" BorderBrush="{StaticResource HareBorderBrush}" BorderThickness="1" CornerRadius="7">
                                    <StackPanel>
                                      <ToggleButton x:Name="addMarkerToolButton" Style="{StaticResource CanvasToolToggleStyle}" Click="AddMarkerTool_Click" AutomationProperties.Name="{world:WorldMapEditorText AddMarker}">
                                        <ToggleButton.ToolTip>
                                            <ToolTip Content="{world:WorldMapEditorText PlaceMarkerHint}"/>
                                        </ToggleButton.ToolTip>
                                        <Grid Width="22" Height="22">
                                            <Ellipse Width="16" Height="16" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="2"/>
                                            <Path Data="M11,6 L11,16 M6,11 L16,11" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        </Grid>
                                      </ToggleButton>
                                      <Button Style="{StaticResource CanvasDeleteToolStyle}" Click="DeleteMarkerTool_Click" ToolTip="{world:WorldMapEditorText DeleteMarkerHint}" AutomationProperties.Name="{world:WorldMapEditorText RemoveMarker}">
                                          <Viewbox Width="18" Height="18"><Path Data="M5,6 L19,6 M8,6 L9,20 L15,20 L16,6 M9,3 L15,3 L16,6 L8,6" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" StrokeLineJoin="Round"/></Viewbox>
                                      </Button>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </ScrollViewer>
                    </Border>
                    <DockPanel Grid.Row="2" Margin="0,8,0,0">
                        <TextBlock DockPanel.Dock="Right" Text="{world:WorldMapEditorText CanvasInteractionHint}" Style="{StaticResource HareMutedTextStyle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <StackPanel Orientation="Horizontal">
                            <CheckBox Content="{world:WorldMapEditorText Grid}" IsChecked="{Binding ShowGrid, Mode=TwoWay}" AutomationProperties.Name="{world:WorldMapEditorText Grid}"/>
                            <CheckBox Margin="12,0,0,0" Content="{world:WorldMapEditorText Labels}" IsChecked="{Binding ShowLabels, Mode=TwoWay}" AutomationProperties.Name="{world:WorldMapEditorText Labels}"/>
                            <CheckBox Margin="12,0,0,0" Content="{world:WorldMapEditorText RawBounds}" IsChecked="{Binding ShowRawBounds, Mode=TwoWay}" AutomationProperties.Name="{world:WorldMapEditorText RawBounds}"/>
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

            <Border Grid.Column="4" Style="{StaticResource HareCardStyle}" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{world:WorldMapEditorText SurfaceInspector}" Style="{StaticResource HareSectionTitleStyle}"/>
                        <Grid Margin="0,8,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource InspectorLabel}" Text="{world:WorldMapEditorText Name}"/>
                            <TextBox Grid.Column="1" Style="{StaticResource InspectorTextBox}" Text="{Binding SelectedSurface.LogicalName, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                            <TextBlock Grid.Row="1" Style="{StaticResource InspectorLabel}" Text="{world:WorldMapEditorText Image}"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedSurface.ImageName}" Style="{StaticResource HareMutedTextStyle}" TextTrimming="CharacterEllipsis" Margin="0,2,0,4"/>
                            <TextBlock Grid.Row="2" Style="{StaticResource InspectorLabel}" Text="{world:WorldMapEditorText Parent}"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource InspectorTextBox}" Text="{Binding SelectedSurface.ParentName, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" ToolTip="{world:WorldMapEditorText ParentHint}"/>
                            <TextBlock Grid.Row="3" Style="{StaticResource InspectorLabel}" Text="{world:WorldMapEditorText MarkerCount}"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedSurface.MarkerCount}" Margin="0,2,0,4"/>
                            <TextBlock Grid.Row="4" Style="{StaticResource InspectorLabel}" Text="{world:WorldMapEditorText LinkCount}"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedSurface.RelationshipSummary}" Style="{StaticResource HareMutedTextStyle}" Margin="0,2,0,4"/>
                        </Grid>
                        <WrapPanel Margin="0,0,0,10">
                            <Button Content="{world:WorldMapEditorText CreateChild}" Command="{x:Static world:WorldMapWorkspace.CreateChildCommand}" AutomationProperties.Name="{world:WorldMapEditorText CreateChild}"/>
                            <Button Margin="6,0,0,0" Content="{world:WorldMapEditorText RemoveFromHierarchy}" Command="{x:Static world:WorldMapWorkspace.RemoveFromHierarchyCommand}" AutomationProperties.Name="{world:WorldMapEditorText RemoveFromHierarchy}"/>
                            <Button Margin="6,0,0,0" Style="{StaticResource HareDangerButtonStyle}" Content="{world:WorldMapEditorText DeleteAsset}" Command="{x:Static world:WorldMapWorkspace.DeleteAssetCommand}" AutomationProperties.Name="{world:WorldMapEditorText DeleteAsset}"/>
                        </WrapPanel>
                        <Separator Margin="0,0,0,12"/>
                        <TextBlock Text="{world:WorldMapEditorText MarkerInspector}" Style="{StaticResource HareSectionTitleStyle}"/>
                        <Grid Margin="0,8,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource CompactInspectorLabel}" Text="{world:WorldMapEditorText Type}"/>
                            <ComboBox Grid.Column="1" Style="{StaticResource InspectorComboBox}" ItemsSource="{Binding MarkerTypes}" DisplayMemberPath="DisplayText" SelectedValuePath="Value" SelectedValue="{Binding SelectedMarker.MarkerType, Mode=TwoWay}" ToolTip="{world:WorldMapEditorText MarkerTypeHint}"/>
                            <TextBlock Grid.Row="1" Style="{StaticResource CompactInspectorLabel}" Text="{world:WorldMapEditorText SpotX}"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource InspectorTextBox}" InputScope="Number" Text="{Binding SelectedMarker.X, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                            <TextBlock Grid.Row="2" Style="{StaticResource CompactInspectorLabel}" Text="{world:WorldMapEditorText SpotY}"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource InspectorTextBox}" InputScope="Number" Text="{Binding SelectedMarker.Y, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                            <TextBlock Grid.Row="3" Style="{StaticResource CompactInspectorLabel}" VerticalAlignment="Top" Margin="0,5,4,0" Text="{world:WorldMapEditorText MapIdsCompact}"/>
                            <Border Grid.Row="3" Grid.Column="1" Margin="0,2,0,6" Padding="6" Background="{StaticResource HareSurfaceAltBrush}" BorderBrush="{StaticResource HareBorderBrush}" BorderThickness="1" CornerRadius="4" ToolTip="{world:WorldMapEditorText MapIdInputHint}">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <ListBox x:Name="referencedMapsListBox" ItemsSource="{Binding SelectedMarker.MapIds}" MinHeight="70" MaxHeight="156" BorderThickness="0" Background="Transparent" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="2,2,2,3" ToolTip="{Binding Converter={StaticResource MapReferenceConverter}, ConverterParameter=ToolTip}">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Padding="5,3" FontFamily="Consolas" FontWeight="SemiBold" Text="{Binding}" VerticalAlignment="Top"/>
                                                    <StackPanel Grid.Column="1" Margin="8,1,4,1">
                                                        <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding Converter={StaticResource MapReferenceConverter}, ConverterParameter=MapName}"/>
                                                        <TextBlock Style="{StaticResource HareMutedTextStyle}" FontSize="11" TextTrimming="CharacterEllipsis" Text="{Binding Converter={StaticResource MapReferenceConverter}, ConverterParameter=StreetName}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,0">
                                        <Button Style="{StaticResource HarePrimaryButtonStyle}" Content="{world:WorldMapEditorText PickMap}" Click="AddMapReference_Click"/>
                                        <Button Margin="6,0,0,0" Content="{world:WorldMapEditorText RemoveMapReference}" Click="RemoveMapReference_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <TextBlock Grid.Row="4" Style="{StaticResource CompactInspectorLabel}" Text="{world:WorldMapEditorText TitleField}"/>
                            <TextBox Grid.Row="4" Grid.Column="1" Style="{StaticResource InspectorTextBox}" Text="{Binding SelectedMarker.Title, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                            <TextBlock Grid.Row="5" Style="{StaticResource CompactInspectorLabel}" Text="{world:WorldMapEditorText Description}"/>
                            <TextBox Grid.Row="5" Grid.Column="1" Style="{StaticResource InspectorTextBox}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="42" Text="{Binding SelectedMarker.Description, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                            <TextBlock Grid.Row="6" Style="{StaticResource CompactInspectorLabel}" VerticalAlignment="Top" Margin="0,5,8,4" Text="{world:WorldMapEditorText TownDescriptionCompact}"/>
                            <TextBox Grid.Row="6" Grid.Column="1" Style="{StaticResource InspectorTextBox}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="42" Text="{Binding SelectedMarker.TownDescription, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                        </Grid>
                        <WrapPanel Margin="0,0,0,8">
                            <Button Content="{world:WorldMapEditorText AddLink}" Command="{x:Static world:WorldMapWorkspace.AddLinkCommand}"/>
                            <Button Margin="6,0,0,0" Content="{world:WorldMapEditorText RemoveMarker}" Command="{x:Static world:WorldMapWorkspace.RemoveMarkerCommand}"/>
                        </WrapPanel>
                        <TextBlock Text="{world:WorldMapEditorText MapSearch}" Style="{StaticResource HareMutedTextStyle}" Margin="0,0,0,3"/>
                        <TextBox Style="{StaticResource InspectorTextBox}" Text="{Binding MapSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="{world:WorldMapEditorText MapSearchHint}"/>
                        <ListBox x:Name="mapSearchResultsListBox" ItemsSource="{Binding MapSearchResults}" SelectedItem="{Binding SelectedMapSearchItem, Mode=TwoWay}" Height="82" Margin="0,0,0,5" BorderThickness="0" DisplayMemberPath="DisplayText" MouseDoubleClick="MapSearchResults_MouseDoubleClick" KeyDown="MapSearchResults_KeyDown"/>
                        <Button Content="{world:WorldMapEditorText AddMap}" Command="{x:Static world:WorldMapWorkspace.AddMapToMarkerCommand}" Margin="0,0,0,8"/>
                        <TabControl Margin="0,0,0,10">
                            <TabItem Header="{world:WorldMapEditorText Links}">
                                <DockPanel>
                                    <Button DockPanel.Dock="Bottom" Content="{world:WorldMapEditorText RemoveLink}" Command="{x:Static world:WorldMapWorkspace.RemoveLinkCommand}" Margin="0,6,0,0"/>
                                    <ListBox x:Name="linksListBox" ItemsSource="{Binding SelectedSurface.Links}" SelectedItem="{Binding SelectedLink, Mode=TwoWay}" BorderThickness="0" MinHeight="70">
                                        <ListBox.ItemTemplate><DataTemplate><Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBox Text="{Binding TargetName, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Margin="0,0,3,0"/><TextBox Grid.Column="1" Text="{Binding Tooltip, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/></Grid></DataTemplate></ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                            </TabItem>
                            <TabItem Header="{world:WorldMapEditorText Fog}">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0"><Button Content="{world:WorldMapEditorText AddFog}" Command="{x:Static world:WorldMapWorkspace.AddFogCommand}"/><Button Margin="6,0,0,0" Content="{world:WorldMapEditorText RemoveFog}" Command="{x:Static world:WorldMapWorkspace.RemoveFogCommand}"/></StackPanel>
                                    <ListBox x:Name="fogListBox" ItemsSource="{Binding SelectedSurface.FogLayers}" SelectedItem="{Binding SelectedFog, Mode=TwoWay}" BorderThickness="0" MinHeight="70">
                                        <ListBox.ItemTemplate><DataTemplate><Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBox Text="{Binding Quest, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" InputScope="Number" Margin="0,0,3,0"/><TextBox Grid.Column="1" Text="{Binding QState, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" InputScope="Number"/></Grid></DataTemplate></ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                            </TabItem>
                            <TabItem Header="{world:WorldMapEditorText Derived}">
                                <ListBox ItemsSource="{Binding DerivedAvailability}" BorderThickness="0" MinHeight="70">
                                    <ListBox.ItemTemplate><DataTemplate><DockPanel Margin="0,2"><Button DockPanel.Dock="Right" Content="{world:WorldMapEditorText OpenMapLife}" Tag="{Binding MapId}" Click="OpenDerivedMap_Click"/><TextBlock Text="{Binding DisplayText}" TextWrapping="Wrap" Margin="0,0,6,0"/></DockPanel></DataTemplate></ListBox.ItemTemplate>
                                </ListBox>
                            </TabItem>
                        </TabControl>
                        <TextBlock Text="{world:WorldMapEditorText NpcMobHint}" Style="{StaticResource HareMutedTextStyle}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <Button Content="{world:WorldMapEditorText OpenMapLife}" Command="{x:Static world:WorldMapWorkspace.RuntimePreviewCommand}" AutomationProperties.Name="{world:WorldMapEditorText OpenMapLife}"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource HareCardStyle}" Margin="12,0,12,8" Padding="12">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="{world:WorldMapEditorText ReviewChanges}" Command="{x:Static world:WorldMapWorkspace.ReviewChangesCommand}"/>
                        <Button Margin="6,0,0,0" Style="{StaticResource HareDangerButtonStyle}" Content="{world:WorldMapEditorText ReplaceBackground}" Command="{x:Static world:WorldMapWorkspace.ReplaceBackgroundCommand}"/>
                    </StackPanel>
                    <TextBlock Text="{world:WorldMapEditorText Diagnostics}" Style="{StaticResource HareSectionTitleStyle}"/>
                </DockPanel>
                <ListBox Grid.Row="1" ItemsSource="{Binding Diagnostics}" BorderThickness="0" Margin="0,8,0,0" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" AutomationProperties.Name="{world:WorldMapEditorText Diagnostics}">
                    <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayText}" TextWrapping="Wrap" Foreground="{StaticResource HareMutedTextBrush}" Padding="3,2"/></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <Border Grid.Row="4" Margin="12,0" Padding="6,4" Background="{StaticResource HareSurfaceAltBrush}" BorderBrush="{StaticResource HareBorderBrush}" BorderThickness="1" CornerRadius="4">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding ValidationSummary}" Style="{StaticResource HareMutedTextStyle}"/>
                <TextBlock Text="{Binding StatusText}" Style="{StaticResource HareMutedTextStyle}" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
